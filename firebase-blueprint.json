{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and MFA metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Primary email address"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Primary verified phone number"
        },
        "role": {
          "type": "string",
          "enum": ["USER", "ADMIN", "TECH_ADMIN"],
          "description": "System privilege role"
        },
        "mfaEnabled": {
          "type": "boolean",
          "description": "Whether 2FA is required"
        },
        "recoveryEmail": {
          "type": "string",
          "format": "email",
          "description": "Backup recovery email for emergency bypass"
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Curated travel place, hotel accommodation, or dining guide",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique listing ID"
        },
        "title": {
          "type": "string",
          "description": "Title of the travel destination or experience"
        },
        "category": {
          "type": "string",
          "enum": ["PLACE", "HOTEL", "FOOD"],
          "description": "Category of travel content"
        },
        "price": {
          "type": "number",
          "description": "Starting price in USD"
        },
        "description": {
          "type": "string",
          "description": "Detailed overview and highlights"
        },
        "images": {
          "type": "array",
          "description": "Image gallery URLs"
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "PENDING_APPROVAL", "PUBLISHED", "REJECTED"],
          "description": "Verification lifecycle status"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the creating admin"
        },
        "approvedBy": {
          "type": "string",
          "description": "UID of approving Super Admin"
        },
        "timestamps": {
          "type": "object",
          "description": "Creation and modification timestamps"
        }
      },
      "required": ["id", "title", "category", "price", "description", "status", "createdBy"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and administrative audit trail",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Log entry identifier"
        },
        "action": {
          "type": "string",
          "description": "Action performed e.g. ADMIN_LOGIN, BYPASS_ATTEMPT, APPROVE_LISTING"
        },
        "performedBy": {
          "type": "string",
          "description": "Identifier of actor"
        },
        "targetId": {
          "type": "string",
          "description": "Target entity or resource ID"
        },
        "ipAddress": {
          "type": "string",
          "description": "Client IP address"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of event"
        }
      },
      "required": ["id", "action", "performedBy", "timestamp"]
    },
    "CustomPost": {
      "title": "CustomPost",
      "description": "Custom administrative or organizational post with granular privileges and access controls",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique post template ID"
        },
        "title": {
          "type": "string",
          "description": "Official post title / designation e.g. Senior Security Lead, Chief Technology Architect"
        },
        "department": {
          "type": "string",
          "description": "Department name e.g. Executive Engineering, Content & Editorial"
        },
        "baseRole": {
          "type": "string",
          "enum": ["TECH_ADMIN", "TECH_SUBADMIN", "ADMIN", "USER"],
          "description": "Underlying base role tier"
        },
        "description": {
          "type": "string",
          "description": "Description of post responsibilities and mandate"
        },
        "privileges": {
          "type": "array",
          "description": "Granted privilege flags"
        },
        "badgeColor": {
          "type": "string",
          "description": "Color code for visual badges"
        },
        "createdBy": {
          "type": "string",
          "description": "Email or UID of Super Admin creator"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "title", "department", "baseRole", "privileges", "createdAt"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "User subscription for price drops on specific travel listings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique alert identifier"
        },
        "userId": {
          "type": "string",
          "description": "User UID who requested the alert"
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of the user"
        },
        "listingId": {
          "type": "string",
          "description": "The destination or experience ID"
        },
        "listingTitle": {
          "type": "string",
          "description": "Title of the listing for reference"
        },
        "targetPrice": {
          "type": "number",
          "description": "Listing price at the time of subscription"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the notification is active"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of alert creation"
        }
      },
      "required": ["id", "userId", "userEmail", "listingId", "listingTitle", "targetPrice", "active", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "User ratings and text reviews for travel destinations, hotels, and dining experiences",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique review identifier"
        },
        "listingId": {
          "type": "string",
          "description": "ID of the reviewed travel listing"
        },
        "userId": {
          "type": "string",
          "description": "UID of the author user"
        },
        "userName": {
          "type": "string",
          "description": "Display name of the reviewer"
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of the reviewer"
        },
        "userAvatar": {
          "type": "string",
          "description": "Avatar image URL of reviewer"
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5"
        },
        "comment": {
          "type": "string",
          "description": "Written review text feedback"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when review was created"
        },
        "isReported": {
          "type": "boolean",
          "description": "Flag indicating if review has been reported for moderation"
        },
        "reportReason": {
          "type": "string",
          "description": "Reason provided by reporting user"
        },
        "reportedBy": {
          "type": "string",
          "description": "User ID of the reporter"
        },
        "reportedByEmail": {
          "type": "string",
          "description": "Email address of the reporter"
        },
        "reportedAt": {
          "type": "string",
          "description": "ISO timestamp when the review was flagged"
        },
        "moderationStatus": {
          "type": "string",
          "enum": ["PENDING", "DISMISSED", "REMOVED"],
          "description": "Moderation status of the review"
        },
        "listingTitle": {
          "type": "string",
          "description": "Title of the listing for display in admin queue"
        }
      },
      "required": ["id", "listingId", "userId", "userName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User records with role definition and MFA states"
    },
    "/listings/{listingId}": {
      "schema": "Listing",
      "description": "Travel listings with multi-stage approval workflow"
    },
    "/custom_posts/{postId}": {
      "schema": "CustomPost",
      "description": "Custom post templates with granular privileges selectable in User Privilege Administration"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System security and administrative audit log trail"
    },
    "/priceAlerts/{alertId}": {
      "schema": "PriceAlert",
      "description": "User price alerts for tracking discounts"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "User guest ratings and reviews for destinations"
    }
  }
}
