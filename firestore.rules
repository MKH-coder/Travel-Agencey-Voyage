rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isTechAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['mukundkrishna.h2008@gmail.com', 'mukundkrishna2008@gmail.com', '8c15mukundkrishna.h@gmail.com'] ||
        request.auth.token.role == 'TECH_ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TECH_ADMIN'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isTechAdmin() ||
        request.auth.token.role == 'ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    // Listings Collection:
    match /listings/{listingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Users Collection:
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isTechAdmin() || true;
    }

    // Custom Posts / Privilege Templates Collection:
    match /custom_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Audit Logs Collection:
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Append-only immutable logs
    }

    // Price Alerts Collection:
    match /priceAlerts/{alertId} {
      allow read, create, update, delete: if true;
    }

    // Reviews Collection:
    match /reviews/{reviewId} {
      allow read, create, update, delete: if true;
    }
  }
}
